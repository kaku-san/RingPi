# Copy selected nonsecret values into your own Pi service environment.
# This template never enables a bridge, installs models or captures a photo.
DOORBELL_CAMERA=auto
DOORBELL_DETECTOR=none
DOORBELL_LOCAL_CAPTIONS=0
DOORBELL_CAPTION_DEADLINE_SECONDS=30
# Defaults are relative to the account running Doorbell; use your own absolute
# path when overriding systemd environment values (the shell does not expand ~).
# DOORBELL_DATA_DIR=/your/private/data/directory
# DOORBELL_ENROLLMENT_BRIDGE_POLICY=/your/private/enrollment-bridge.json
# Store Bot keys securely in your own service environment, never in this file.
# Optional command queue. Leave the URL unset so the install does not poll.
# It is a separate URL from the Grok routine webhook. See docs/OUTBOUND_COMMANDS.md.
# DOORBELL_GROK_COMMAND_QUEUE_URL=https://QUEUE_HOST/commands
# DOORBELL_GROK_COMMAND_QUEUE_KEY=PASTE_QUEUE_BEARER_OR_LEAVE_UNSET
# Probable-match names are sent unless this is set false.
# WEBHOOK_INCLUDE_MATCH_NAME=false
# Required only for deploy/agent-doorbell-button.service. No default BCM pin.
# DOORBELL_BUTTON_BCM=
# Optional text-only visit line from Qwen 2.5 1.5B Instruct (local text model, llama.cpp).
# Leave unset, or point at a local GGUF. A missing file skips the model and uses the existing fallback.
# DOORBELL_TEXT_MODEL_PATH=/path/to/qwen2.5-1.5b-instruct-q4_k_m.gguf
